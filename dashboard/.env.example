# Copier en .env.local (Next.js le charge automatiquement) et remplir.
# Aucune clé secrète ne doit jamais être committée ni exposée au frontend
# (pas de préfixe NEXT_PUBLIC_ sur les variables sensibles ci-dessous).

# --- Chariow --------------------------------------------------------------
# Base URL de l'API officielle (voir chariow.dev/api-reference)
CHARIOW_API_BASE_URL=https://api.chariow.com/v1
# Clé API générée depuis le dashboard Chariow — Bearer token, jamais en dur
CHARIOW_API_KEY=
# Secret partagé pour vérifier la signature du webhook "sale.completed"
CHARIOW_WEBHOOK_SECRET=

# --- Meta Graph API (Instagram Business) -----------------------------------
# App créée sur developers.facebook.com, compte Instagram Business connecté
# à une Page Facebook.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_IG_USER_ID=
# Image de secours utilisée quand un produit n'a pas encore de visuel propre
# (products.image_url) — Instagram exige une image pour tout post.
META_DEFAULT_IMAGE_URL=https://placehold.co/1080x1080/1a2b4c/ffffff.png?text=Shukrani+Business

# --- Orchestrateur IA (Claude API) -----------------------------------------
ANTHROPIC_API_KEY=

# --- Paramètres MVP ---------------------------------------------------------
# Catégorie de produits ciblée (paramétrable, doit correspondre à la valeur
# "categorie" des produits en base et/ou côté Chariow)
ACTIVE_CATEGORY=developpement-personnel
# Budget publicitaire hebdomadaire plafonné (devise: USD), 0 = pas de pub payante
AD_BUDGET_WEEKLY_CAP=0
# Publication automatique désactivée par défaut — mode brouillon obligatoire
# tant que Deograce ne l'active pas explicitement depuis le dashboard.
AUTO_PUBLISH_INSTAGRAM=false

# --- Base de données ---------------------------------------------------------
DATABASE_PATH=./data/agent.db
