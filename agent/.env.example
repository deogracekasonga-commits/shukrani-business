# Copier ce fichier en .env et remplir uniquement ce qui est disponible.
# L'agent fonctionne sans AUCUNE de ces variables : tout tourne en mode
# simulation (dry-run) tant qu'elles ne sont pas configurées.

PORT=3000

# --- Meta Graph API (Facebook Page / Instagram Business) -------------------
# Créer une app sur developers.facebook.com, obtenir un token de Page
# longue durée avec les permissions pages_manage_posts, pages_read_engagement.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# --- Chariow -----------------------------------------------------------------
# Secret partagé pour vérifier la signature HMAC des webhooks de commande
# envoyés par Chariow (à obtenir depuis le panneau Chariow une fois le
# webhook configuré côté boutique). Sans ce secret, le endpoint
# /webhooks/chariow refuse tous les événements par sécurité.
CHARIOW_WEBHOOK_SECRET=

# --- TikTok (phase 2) --------------------------------------------------------
TIKTOK_ACCESS_TOKEN=

# --- WhatsApp Business Cloud API (phase 2) ----------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
