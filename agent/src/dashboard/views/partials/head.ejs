<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> — Agent Marketing Shukrani</title>
<style>
  :root{ --ink:#1C1B3A; --plum:#3D1E52; --cream:#FFF8EC; --amber:#FFB238; --coral:#FF6153; --teal:#1FA98F; --paper:#FFFDF8; }
  *{box-sizing:border-box;}
  body{ margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Manrope,sans-serif; color:var(--ink); background:var(--paper); }
  header{ background:var(--plum); color:var(--cream); padding:16px 28px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; }
  header .brand{ font-weight:700; font-size:1.1rem; }
  header .brand span{ color:var(--amber); }
  nav a{ color:var(--cream); text-decoration:none; margin-right:18px; font-size:0.92rem; opacity:0.85; }
  nav a:hover{ opacity:1; text-decoration:underline; }
  main{ max-width:1000px; margin:0 auto; padding:28px; }
  h1{ font-size:1.5rem; margin:0 0 6px; }
  .subtitle{ color:rgba(28,27,58,0.6); margin-bottom:24px; }
  .card{ background:#fff; border:1px solid rgba(28,27,58,0.08); border-radius:14px; padding:18px 20px; margin-bottom:16px; box-shadow:0 2px 10px rgba(28,27,58,0.04); }
  .badge{ display:inline-block; padding:2px 10px; border-radius:100px; font-size:0.72rem; font-weight:700; text-transform:uppercase; letter-spacing:0.03em; }
  .badge.draft{ background:#FFF1D6; color:#9A6300; }
  .badge.approved{ background:#DFF7EF; color:#0F7A5F; }
  .badge.scheduled{ background:#E6E6FA; color:var(--plum); }
  .badge.published{ background:#D9F2EA; color:#0F7A5F; }
  .badge.rejected{ background:#FFE1DE; color:#B23A2E; }
  .hook{ font-weight:700; margin:8px 0 4px; }
  pre.caption{ white-space:pre-wrap; font-family:inherit; background:var(--cream); padding:12px; border-radius:10px; font-size:0.92rem; }
  .meta{ font-size:0.82rem; color:rgba(28,27,58,0.55); margin-bottom:6px; }
  .actions form{ display:inline; }
  button, .btn{ font:inherit; cursor:pointer; border:none; border-radius:100px; padding:8px 16px; font-weight:700; font-size:0.85rem; margin-right:8px; }
  .btn-approve{ background:var(--teal); color:#fff; }
  .btn-reject{ background:var(--coral); color:#fff; }
  .btn-secondary{ background:var(--cream); color:var(--ink); border:1px solid rgba(28,27,58,0.15); }
  table{ width:100%; border-collapse:collapse; font-size:0.9rem; }
  th, td{ text-align:left; padding:8px 10px; border-bottom:1px solid rgba(28,27,58,0.08); }
  .stat{ display:inline-block; margin-right:28px; }
  .stat .value{ font-size:1.6rem; font-weight:700; display:block; }
  .stat .label{ font-size:0.8rem; color:rgba(28,27,58,0.55); }
  label{ display:block; font-weight:600; margin:14px 0 6px; font-size:0.9rem; }
  input[type=text], input[type=number]{ width:100%; padding:9px 12px; border-radius:8px; border:1px solid rgba(28,27,58,0.2); font:inherit; }
  .empty{ color:rgba(28,27,58,0.5); font-style:italic; }
  .flash{ background:#DFF7EF; color:#0F7A5F; padding:10px 16px; border-radius:10px; margin-bottom:18px; font-size:0.9rem; }
</style>
</head>
<body>
<header>
  <div class="brand">Shukrani<span> Business</span> — Agent Marketing</div>
  <nav>
    <a href="/drafts">Validation</a>
    <a href="/calendar">Calendrier</a>
    <a href="/conversations">Service client</a>
    <a href="/reports/weekly">Rapport hebdo</a>
    <a href="/reports/ab">Test A/B</a>
    <a href="/settings">Réglages</a>
  </nav>
</header>
<main>
